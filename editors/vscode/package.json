{
  "name": "commerceos-api",
  "displayName": "CommerceOS .api files",
  "description": "Syntax highlighting and completions for the .api batch files of the CommerceOS API client",
  "version": "0.0.0",
  "publisher": "heads",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/byheads/commerceos-api-client"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:commerceos-api"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "commerceos-api",
        "aliases": [
          "CommerceOS API",
          "api"
        ],
        "extensions": [
          ".api"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "commerceos-api",
        "scopeName": "source.api",
        "path": "./syntaxes/api.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "CommerceOS .api files",
      "properties": {
        "commerceosApi.binary": {
          "type": "string",
          "default": "",
          "description": "The CommerceOS API client that is asked what can stand at the cursor. Empty: the `api` on the PATH."
        }
      }
    }
  }
}
